      <Single Name="Object" Type="{6f9dac99-8de1-4efc-8465-68ac443b7d08}" Method="IArchivable">
        <Single Name="SpecialFunc" Type="{0db3d7bb-cde0-4416-9a7b-ce49a0124323}">None</Single>
        <Single Name="Implementation" Type="{3b83b776-fb25-43b8-99f2-3c507c9143fc}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">// ===== NODALIS CODESYS MANUAL SETUP =====
// Automatic Library Manager insertion may fail on some CODESYS runtimes.
// Target runtime profile: CODESYS Control Win V3 x64
// Manual device selection: Add Device -&gt; CODESYS Control Win V3 x64
// If libraries are unresolved, add these in Device/Application -&gt; Library Manager:
//   - Standard
//   - ModbusFB
//   - Modbus
//   - IoDrvModbus
//   - BACnet
//   - BACnet2
//   - IoDrvBACnet
//
// Globals are declared in GVL 'NODALIS_IO_MAP'.
// Source //Global entries are PLC-side input points (and marked for OPC UA symbol export).
// Global variable bindings:
//   - SW1 at %IX0.0 (from //Global)
//   - SW2 at %IX0.1 (from //Global)
//
// Interface mapping summary (from //Map):
// MODBUS-TCP:
//   - map1: %IX0.0 &lt;= 192.168.9.17:5502 remote=0 poll=500ms
//   - map2: %QX0.0 &lt;= 192.168.9.17:5502 remote=16 poll=500ms
//   Settings: configure Modbus TCP/RTU device/channel, unit-id (if needed), timeout, and scan interval.
// BACNET-IP:
//   - map1: %QX0.1 &lt;= 192.168.9.19:47808 remote=100 poll=1000ms
//   Settings: configure BACnet interface (IP/UDP), device instance/network, and object/property access.
//
// Task configuration:
//   - Task T100: interval=100 priority=1
// Program instance binding:
//   - Instance MainThread : PLC_LD on task T100
// =========================================
PLS1.IN := SW1;
PLS1.PT := 1000;
%QX0.0 := (PLS1.Q);
CTU1.CU := SW1;
CTU1.PV := 2;
CU := (CTU1.CV);
SW1R := (CTU1.Q);
IF (((CU = 1))) THEN
                            %QX0.1 := 1;
                        END_IF;
IF ((SW1R)) THEN
                            %QX0.1 := 0;
                        END_IF;
CTU1.R := SW1R;</Single>
            <Single Name="LineInfoPersistence" Type="string">205413fa-28a4-4f5c-83c3-b39fe8679821_Impl_LineIds</Single>
          </Single>
        </Single>
        <Single Name="Interface" Type="{a9ed5b7e-75c5-4651-af16-d2c27e98cb94}" Method="IArchivable">
          <Single Name="TextDocument" Type="{f3878285-8e4f-490b-bb1b-9acbb7eb04db}" Method="IArchivable">
            <Single Name="TextBlobForSerialisation" Type="string">PROGRAM PLC_LD
VAR
        PLS1  : TP;
IL  : ULINT;
SW1P  : BOOL;
SR1  : SR;
CTU1  : CTU;
SW1R  : BOOL;
CU  : WORD;

    END_VAR</Single>
            <Single Name="LineInfoPersistence" Type="string">205413fa-28a4-4f5c-83c3-b39fe8679821_Decl_LineIds</Single>
